# ===========================================
# COMPETITOR INTELLIGENCE DASHBOARD
# Environment Configuration
# ===========================================

# App
NODE_ENV=development
APP_PORT=3001
APP_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/competitor_intelligence

# Redis
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# AI Providers
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
OPENAI_API_KEY=sk-your-openai-key
AI_PROVIDER=anthropic  # anthropic | openai

# Email (for alerts)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
ALERT_FROM_EMAIL=alerts@competitor-intelligence.com
ALERT_TO_EMAIL=team@yourcompany.com

# LinkedIn Data Collection — Apify (required for LinkedIn posts)
# Get your key at: https://console.apify.com/account/integrations
APIFY_API_KEY=apify_api_your-key
# Actors used:
#   anchor-scraper/linkedin-company-posts  — scrapes posts from a company LinkedIn page
#   curious_coder/linkedin-post-search-scraper — fallback keyword search
#
# Optional alternatives (not used by default):
BRIGHTDATA_API_KEY=
PROXYCURL_API_KEY=

# News Sources
NEWSAPI_KEY=your-newsapi-key
SERPER_API_KEY=your-serper-key  # Google News scraping

# Website Scraping
SCREENSHOT_STORAGE_PATH=./storage/screenshots
SNAPSHOTS_STORAGE_PATH=./storage/snapshots

# AWS S3 (for production screenshot storage)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=competitor-intelligence-screenshots

# Rate Limiting
SCRAPER_RATE_LIMIT_DELAY=2000  # ms between requests
LINKEDIN_SCRAPE_INTERVAL=86400000  # 24 hours in ms
WEBSITE_SCRAPE_INTERVAL=86400000   # 24 hours in ms
NEWS_SCRAPE_INTERVAL=3600000       # 1 hour in ms

# Queue Configuration
QUEUE_CONCURRENCY=3
QUEUE_RETRY_ATTEMPTS=3
QUEUE_RETRY_DELAY=5000

# Cron Schedules (cron syntax)
CRON_WEEKLY_REPORT=0 9 * * 1     # Monday 9am
CRON_WEBSITE_SCRAPE=0 2 * * *    # 2am daily
CRON_LINKEDIN_SCRAPE=0 6 * * *   # 6am daily
CRON_NEWS_SCRAPE=0 */4 * * *     # Every 4 hours

# Playwright
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_TIMEOUT=30000

# Feature Flags
ENABLE_EMAIL_ALERTS=true
ENABLE_LINKEDIN_SCRAPING=true
ENABLE_WEBSITE_SCRAPING=true
ENABLE_NEWS_MONITORING=true
ENABLE_SOCIAL_MONITORING=true
